[Unit]
Description=Портал инструментов для манифестов (mukhline.nasekomuspro.ru)
After=network.target

[Service]
User=manifest-portal
WorkingDirectory=/opt/manifest-portal
# PORT, DB_PATH, SITE_ROOT, PUBLIC_ORIGIN, при необходимости SMTP_* — права файла 600
EnvironmentFile=/etc/manifest-portal.env
ExecStart=/usr/bin/node portal/server/main.js
Restart=always
RestartSec=3

# Файлы, которые создаёт сервис (база, WAL), — только для владельца
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
# /var/lib/manifest-portal создаёт и отдаёт во владение пользователю сам systemd (права 0700);
# при ProtectSystem=strict он же остаётся единственным местом, куда сервис может писать
StateDirectory=manifest-portal
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
